<UserControl x:Class="EggTimer.Controls.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="Box"
                 Grid.RowSpan="2"
                 MinWidth="64"
                 FontSize="20"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center"
                 MaxLength="2"
                 InputScope="Number"
                 PreviewTextInput="Box_PreviewTextInput"
                 PreviewKeyDown="Box_PreviewKeyDown"
                 LostKeyboardFocus="Box_LostKeyboardFocus"
                 GotKeyboardFocus="Box_GotKeyboardFocus"
                 MouseWheel="Box_MouseWheel" />

        <RepeatButton x:Name="UpButton" Grid.Column="1" Grid.Row="0"
                      Margin="4,0,0,1" Padding="8,0" MinHeight="0" MinWidth="0"
                      FontSize="10" Content="▲" Focusable="False"
                      Delay="400" Interval="80"
                      Click="Up_Click" ToolTip="Increase" />
        <RepeatButton x:Name="DownButton" Grid.Column="1" Grid.Row="1"
                      Margin="4,1,0,0" Padding="8,0" MinHeight="0" MinWidth="0"
                      FontSize="10" Content="▼" Focusable="False"
                      Delay="400" Interval="80"
                      Click="Down_Click" ToolTip="Decrease" />
    </Grid>
</UserControl>
