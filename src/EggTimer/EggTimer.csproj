<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EggTimer</RootNamespace>
    <AssemblyName>EggTimer</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Egg Timer</Product>
    <!-- Required by the LibraryImport source generator (FlashWindowEx). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Fluent (Windows 11) theme via Application.ThemeMode is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggTimer.Tests" />
  </ItemGroup>

</Project>
