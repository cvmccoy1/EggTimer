<Window x:Class="EggTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EggTimer.Controls"
        Title="Egg Timer"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,16,24,20" MinWidth="340">

        <!-- Display -->
        <TextBlock x:Name="CaptionText"
                   HorizontalAlignment="Center"
                   FontSize="14"
                   Height="20"
                   Opacity="0.75" />
        <TextBlock x:Name="DisplayText"
                   HorizontalAlignment="Center"
                   FontFamily="Segoe UI Variable Display, Segoe UI"
                   FontWeight="SemiBold"
                   FontSize="80"
                   Typography.NumeralAlignment="Tabular"
                   Margin="0,-8,0,8"
                   Text="05:00" />

        <!-- Time inputs -->
        <StackPanel x:Name="InputPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Minutes" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.75" />
                <controls:NumericUpDown x:Name="MinutesBox" Minimum="0" Maximum="99" Height="44" />
            </StackPanel>
            <TextBlock Text=":" FontSize="28" VerticalAlignment="Bottom" Margin="10,0,10,4" />
            <StackPanel>
                <TextBlock Text="Seconds" HorizontalAlignment="Center" Margin="0,0,0,4" Opacity="0.75" />
                <controls:NumericUpDown x:Name="SecondsBox" Minimum="0" Maximum="59" Height="44" />
            </StackPanel>
        </StackPanel>

        <!-- Presets -->
        <StackPanel x:Name="PresetPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Button Style="{StaticResource PresetButton}" Content="1 min" Tag="1" Click="Preset_Click" />
            <Button Style="{StaticResource PresetButton}" Content="3 min" Tag="3" Click="Preset_Click" />
            <Button Style="{StaticResource PresetButton}" Content="5 min" Tag="5" Click="Preset_Click" />
            <Button Style="{StaticResource PresetButton}" Content="10 min" Tag="10" Click="Preset_Click" />
        </StackPanel>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Button x:Name="StartButton" Style="{StaticResource ActionButton}" Content="Start" IsDefault="True" Click="Start_Click" />
            <Button x:Name="PauseButton" Style="{StaticResource ActionButton}" Content="Pause" Click="Pause_Click" />
            <Button x:Name="ResetButton" Style="{StaticResource ActionButton}" Content="Reset" Click="Reset_Click" />
        </StackPanel>

        <!-- Options -->
        <CheckBox x:Name="WarningBeepsCheck"
                  Content="3-second warning beeps at start and end"
                  Margin="4,0,0,10"
                  Click="WarningBeeps_Click" />

        <Grid Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Slider x:Name="VolumeSlider" Grid.Column="1"
                    Minimum="0" Maximum="100"
                    SmallChange="5" LargeChange="10"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    VerticalAlignment="Center"
                    ValueChanged="Volume_ValueChanged" />
            <TextBlock x:Name="VolumeText" Grid.Column="2"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Text="70%" />
        </Grid>
    </StackPanel>
</Window>
